{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "effect",
    "broker",
    "authorized_at",
    "grant",
    "repository",
    "repository_instance",
    "resource",
    "work",
    "intent_digest",
    "state"
  ],
  "properties": {
    "effect": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "broker": {
      "const": "broker:git"
    },
    "authorized_at": {
      "$ref": "defs.schema.json#/$defs/timestamp"
    },
    "grant": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "repository": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "repository_instance": {
      "$ref": "defs.schema.json#/$defs/sha256"
    },
    "resource": {
      "$ref": "defs.schema.json#/$defs/branch"
    },
    "work": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "intent_digest": {
      "$ref": "defs.schema.json#/$defs/sha256"
    },
    "state": {
      "enum": [
        "dispatching",
        "pending",
        "confirmed_happened",
        "confirmed_absent"
      ]
    },
    "observation": {
      "$ref": "defs.schema.json#/$defs/id"
    },
    "reason": {
      "$ref": "defs.schema.json#/$defs/nonempty"
    }
  }
}
