{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["target", "raised_by", "reason", "evidence", "state", "resolution"],
  "properties": {
    "target": {"$ref": "defs.schema.json#/$defs/id"},
    "raised_by": {"$ref": "defs.schema.json#/$defs/id"},
    "reason": {"$ref": "defs.schema.json#/$defs/nonempty"},
    "evidence": {"type": "array", "items": {"$ref": "defs.schema.json#/$defs/sha256"}},
    "state": {"enum": ["open", "resolved"]},
    "resolution": {"oneOf": [{"$ref": "defs.schema.json#/$defs/nonempty"}, {"type": "null"}]}
  }
}
